  "routes": {
    "chapter_7_hanami_1": [
      {
        "label": "木框輕悶響",
        "trigger": "木框被推回去時，發出一聲很輕的悶響。",
        "commands": [
          "play sound \"audio/sfx/world/world_frame_thud_soft.ogg\""
        ],
        "script_line": 1236
      },
      {
        "label": "燈架晃動（沿用）",
        "trigger": "夢見還來不及退後，燈火便猛地一晃。",
        "commands": [
          "play sound \"audio/sfx/world/world_lamp_sway.ogg\" volume 0.85"
        ],
        "script_line": 1257
      },
      {
        "label": "拖動衣料",
        "trigger": "絡新婦將她拖進房裡，手掌覆住她的口鼻。",
        "commands": [
          "play sound \"audio/sfx/world/world_cloth_drag_soft.ogg\""
        ],
        "script_line": 1261
      },
      {
        "label": "輕微掙動衣料",
        "trigger": "夢見的指尖抓住她的手腕，細微地掙動著。",
        "commands": [
          "play sound \"audio/sfx/world/world_cloth_soft.ogg\" volume 0.7"
        ],
        "script_line": 1264
      },
      {
        "label": "燈盞落地、無碎裂",
        "trigger": "燈盞落在地上，火光晃了晃，沒有翻倒。",
        "commands": [
          "play sound \"audio/sfx/world/world_lamp_drop.ogg\""
        ],
        "script_line": 1284
      },
      {
        "label": "幾乎無聲的倒下",
        "trigger": "夢見倒下時，幾乎沒有發出聲音。",
        "commands": [
          "play sound \"audio/sfx/battle/battle_body_fall_soft.ogg\" volume 0.18"
        ],
        "script_line": 1287
      },
      {
        "label": "巨蛛倒下（沿用重物撞擊）",
        "trigger": "土蜘蛛終於倒下。",
        "commands": [
          "play sound \"audio/sfx/battle/battle_omukade_impact.ogg\" volume 0.55"
        ],
        "script_line": 1295
      },
      {
        "label": "趕回庄門（沿用濕地腳步）",
        "trigger": "他們趕回月下庄。",
        "commands": [
          "play sound \"audio/sfx/world/world_footstep_wet.ogg\" volume 0.7"
        ],
        "script_line": 1308
      },
      {
        "label": "庄門薙刀揮動",
        "trigger": "花見的動作很大，很急，像把所有痛都甩出去。",
        "commands": [
          "play sound \"audio/sfx/battle/battle_naginata_whoosh.ogg\""
        ],
        "script_line": 1318
      },
      {
        "label": "蟲影纏住退路",
        "trigger": "驚蟄的蟲影從側面纏住她的腳。",
        "commands": [
          "play sound \"audio/sfx/magic/magic_insect_summon.ogg\" volume 0.45"
        ],
        "script_line": 1321
      },
      {
        "label": "黑影斷裂",
        "trigger": "一息之間，黑影碎成兩半。",
        "commands": [
          "play sound \"audio/sfx/battle/battle_silk_cut.ogg\" volume 0.8"
        ],
        "script_line": 1324
      },
      {
        "label": "衝進屋裡的短腳步",
        "trigger": "他們衝進屋裡。",
        "commands": [
          "play sound \"audio/sfx/world/world_footstep_wood.ogg\" volume 0.65"
        ],
        "script_line": 1336
      },
      {
        "label": "跪地輕觸地面",
        "trigger": "花見跪在地上，像被抽走了骨頭。",
        "commands": [
          "play sound \"audio/sfx/battle/battle_body_fall_soft.ogg\" volume 0.28"
        ],
        "script_line": 1344
      },
      {
        "label": "取回黑卡的紙布聲",
        "trigger": "他把卡片從花見身上取回。",
        "commands": [
          "play sound \"audio/sfx/world/world_black_card_stow.ogg\" volume 0.8"
        ],
        "script_line": 1358
      },
      {
        "label": "撕開黑卡",
        "trigger": "撕開。",
        "commands": [
          "play sound \"audio/sfx/magic/magic_black_card_tear.ogg\""
        ],
        "script_line": 1364
      },
      {
        "label": "撕卡後停止短音、回退保留安靜",
        "trigger": "風停了一瞬。",
        "commands": [
          "stop sound fadeout 0.10"
        ],
        "script_line": 1367
      }
    ],
